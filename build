#!/bin/bash
# Build the *.plasmoid package for the KDE Store.
# Translations are merged and compiled first; the build is cancelled when
# that changes package/translate, so commit those changes first.

cd "$(dirname "$0")"
source ./scripts/common.sh

requireCommand zip "sudo zypper install zip"

### Translations
echoGray "[build] Merging translations"
bash package/translate/merge || exit 1
bash package/translate/build || exit 1
if command -v git &> /dev/null && [ -d .git ]; then
	if [ -n "$(git status --porcelain package/translate)" ]; then
		echoRed "[build] Translations changed. Commit them, then build again."
		git status --short package/translate
		exit 1
	fi
fi

### *.plasmoid
packageName="$(metadata KPlugin.Id)"
packageName="${packageName##*.}" # Strip namespace (Eg: "org.kde.plasma.")
packageVersion="$(metadata KPlugin.Version)"
filename="${packageName}-v${packageVersion}-plasma6.plasmoid"

rm -f "${packageName}"-v*.plasmoid
echoGray "[build] Zipping '${filename}'"
(cd package && zip -qr "../${filename}" . -x '*.qmlc' -x '*.jsc' -x 'translate/*') || exit 1
echoGray "[build] md5: $(md5sum "$filename" | awk '{ print $1 }')"
echoGray "[build] sha256: $(sha256sum "$filename" | awk '{ print $1 }')"
echoGreen "[build] Done"
