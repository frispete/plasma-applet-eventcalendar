#!/bin/bash
# Install the widget, or upgrade it if it is already installed.
# An upgrade restarts plasmashell so the new QML is loaded.
#   --restart, -r   restart plasmashell after a fresh install too

cd "$(dirname "$0")"
source ./scripts/common.sh

restartPlasmashell=false
for arg in "$@"; do
	case "$arg" in
		-r|--restart) restartPlasmashell=true;;
	esac
done

packageId="$(metadata KPlugin.Id)"
packageType="$(metadata KPackageStructure)"

if kpackagetool6 --type="$packageType" --show="$packageId" &> /dev/null; then
	kpackagetool6 --type="$packageType" --upgrade package || exit 1
	restartPlasmashell=true
else
	kpackagetool6 --type="$packageType" --install package || exit 1
fi

if $restartPlasmashell; then
	restartPlasmashell
fi
